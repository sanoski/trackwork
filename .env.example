# MOW Tracker configuration. Copy to .env and fill in (deploy/setup.sh does this for you).

# Required. A long random secret that signs sign-in cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# production (default) requires HTTPS for sign-in cookies. Use development only on a laptop.
ENVIRONMENT=production

# Host name Caddy serves (docker-compose). Use localhost for a local trial.
TRACKWORK_DOMAIN=localhost

# Where the app keeps its data. Docker uses the /data volume automatically; on a bare-metal
# install set an absolute path such as /opt/trackwork/data.
DATA_DIR=./data

# Let anyone read the dashboard without signing in (writes always need a sign-in).
PUBLIC_READ=false

# The weekly report timer runs inside the app. Only turn it off if something else sends it.
SCHEDULER_ENABLED=true

# First-run defaults for mail and recipients. Once saved in the app (Users & Settings), the
# app's own settings win and these are ignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_RECIPIENT=
REPORT_EMAIL_SENDER=

# MCP server for AI assistants (Claude), served at /mcp. Off by default.
MCP_ENABLED=false
# token  = per-user tokens created in Users & Settings (works with Claude Code and API clients)
# azure | google | github = sign in through that provider (what claude.ai web connectors need)
# none   = no auth at all: local development only, never on the internet
MCP_AUTH_PROVIDER=token
# Public https URL of this app, required by the OAuth providers, e.g. https://mow.example.com
MCP_BASE_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_TENANT=
